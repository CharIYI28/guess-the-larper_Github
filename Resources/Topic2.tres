[resource]
script = ExtResource("1_vatc4")
name = "Shin"
text = "Dragon Quest is a long-running Japanese role-playing game (JRPG) franchise created in 1986 by Yuji Horii, Akira Toriyama, and Koichi Sugiyama, and published by Square Enix. Known for helping establish the console JRPG genre, the series follows heroes on fantasy quests using turn-based combat and features iconic monster designs like the blue Slime. • Creators & Style: Game designer Yuji Horii crafted the stories and systems, Dragon Ball creator Akira Toriyama designed the characters and monsters, and composer Koichi Sugiyama wrote the orchestral score.• Origins & Name Change: The first Dragon Quest game launched in Japan in 1986 on the Famicom and MSX. Early Western releases used the name Dragon Warrior due to trademark conflicts before adopting Dragon Quest globally.• Gameplay: Most mainline entries center on classic turn-based battles, party progression, town exploration, and defeating evil forces, while keeping mechanics approachable."
