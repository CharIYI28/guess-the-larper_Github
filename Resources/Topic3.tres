[ext_resource type="Script" uid="uid://c2x7jh0w8xsrt" path="res://Script/Topic_template.cs" id="1_ihlkw"]

[resource]
script = ExtResource("1_ihlkw")
name = "GIGA"
text = "• Vocaloid Roots: He began uploading Vocaloid music to Niconico around 2009–2010 and broke through with hits like \"Gigantic O.T.N\" (2012) and \"Hibikase\" (2014), helping shape Vocaloid EDM. He frequently uses Kagamine Len and Kagamine Rin, alongside Hatsune Miku and GUMI.• REOL & Collaborations: He worked closely with singer-songwriter Reol and video creator Okiku, forming the musical unit REOL under Toy's Factory before disbanding in 2017. He has also had frequent creative partnerships with producers like Orebanana-P (\"Gigabanana\") and TeddyLoid.• Major Works: Beyond Vocaloid classics and Project SEKAI: Colorful Stage! tracks like \"Ready Steady\", \"Wah Wah World\", and \"Beyond the way\", he has composed and arranged major mainstream hits—including \"Odo\" and \"Show\" for Ado."
funfacts = Array[String](["• Vocaloid Roots: He began uploading Vocaloid music to Niconico around 2009–2010 and broke through with hits like \"Gigantic O.T.N\" (2012) and \"Hibikase\" (2014), helping shape Vocaloid EDM. He frequently uses Kagamine Len and Kagamine Rin, alongside Hatsune Miku and GUMI.• REOL & Collaborations: He worked closely with singer-songwriter Reol and video creator Okiku, forming the musical unit REOL under Toy's Factory before disbanding in 2017. He has also had frequent creative partnerships with producers like Orebanana-P (\"Gigabanana\") and TeddyLoid.• Major Works: Beyond Vocaloid classics and Project SEKAI: Colorful Stage! tracks like \"Ready Steady\", \"Wah Wah World\", and \"Beyond the way\", he has composed and arranged major mainstream hits—including \"Odo\" and \"Show\" for Ado.", "Hatsune Miku is a world-famous virtual pop star and singing voice software.Key Details• Release Date: August 31, 2007• Creator: Crypton Future Media• Voice Provider: Japanese voice actress Saki Fujita• Meaning of Name: \"The first sound of the future\" (Hatsu = first, ne = sound, miku = future)• Character Design: Eternally 16 years old, standing 158 cm tall, with iconic turquoise twin-tail hair and futuristic attire.How She Works• Software, Not AI: Miku is not a generative artificial intelligence. She is a singing synthesizer (originally powered by Yamaha's Vocaloid engine) where users type in melodies and lyrics to make her sing.• Crowd-Created Star: Fans, indie musicians, and producers write original songs, design music videos, and create art for her. Famous tracks like \"Melt\" and \"World is Mine\" helped propel her into a global phenomenon."])
